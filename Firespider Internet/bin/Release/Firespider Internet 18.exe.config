        </sharedListeners>
    </system.diagnostics>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/></startup>
    <userSettings>
        <Firespider_Internet.My.MySettings>
            <setting name="h" serializeAs="String">
                <value>http://fsin.glitch.me/</value>
