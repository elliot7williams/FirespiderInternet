            </setting>
            <setting name="si" serializeAs="String">
                <value>e</value>
            </setting>
            <setting name="se" serializeAs="String">
                <value>www.bing.com/search?q=</value>
            </setting>
            <setting name="b0" serializeAs="String">
                <value>e</value>
            </setting>
            <setting name="uh" serializeAs="Xml">
                <value>
                    <ArrayOfString xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
